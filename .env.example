# Backend Environment Variables (Express API)
GEMINI_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.5-flash
API_PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/career_coach?retryWrites=true&w=majority
NODE_ENV=development

# Frontend Environment Variables (Vite)
# When deploying the frontend to Vercel/Netlify/Cloudflare, set this to your hosted backend URL:
VITE_API_BASE_URL=http://localhost:8787
